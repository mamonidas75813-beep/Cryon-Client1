{
  "name": "cryon-client",
  "version": "0.11.7",
  "description": "CRYON CLIENT \u2014 premium FastClient-inspired Minecraft Java launcher",
  "private": true,
  "type": "module",
  "main": "src/main.js",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "test": "node --test tests/*.test.js",
    "check": "node scripts/check-source.js",
    "build": "node scripts/build-windows.js",
    "build:installer": "electron-builder --win nsis --x64 --config electron-builder.nsis.yml --publish never",
    "build:portable": "electron-builder --win portable --x64 --config electron-builder.portable.yml --publish never",
    "build:windows": "node scripts/build-windows.js",
    "check:partners": "node scripts/check-partner-feed.js",
    "configure:release": "node scripts/configure-release.js"
  },
  "dependencies": {
    "eml-lib": "^2.7.4",
    "electron-updater": "^6.6.2"
  },
  "devDependencies": {
    "electron": "^45.3.2",
    "electron-builder": "^26.18.1"
  }
}
